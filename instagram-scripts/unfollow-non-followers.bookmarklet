javascript:(()=>{const S=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},W=(k,v)=>localStorage.setItem(k,JSON.stringify(v)),sleep=ms=>new Promise(r=>setTimeout(r,ms)),rnd=(a,b)=>a+Math.random()*(b-a),btns=d=>[...d.querySelectorAll('button, div[role=button]')],LIMIT=/Try Again Later|restrict certain activity|action (was )?blocked/i,dlg=(d,txt)=>{const els=[...d.querySelectorAll('[role=dialog] button,[role=dialog] [role=button],[role=dialog] span,[role=dialog] div')].filter(e=>(e.innerText||'').trim()===txt);if(!els.length)return null;const e=els[els.length-1];return e.closest('button,[role=button]')||e};document.getElementById('uf_panel')?.remove();const p=document.createElement('div');p.id='uf_panel';p.style.cssText='position:fixed;top:10px;left:100px;z-index:99999;width:460px;background:lavender;color:black;font:14px monospace;padding:10px;border:2px solid black;white-space:pre-wrap';const start=document.createElement('button');start.textContent='START unfollowing';start.style.cssText='width:440px;height:60px;font-size:18px;background:tomato;color:white';const stop=document.createElement('button');stop.textContent='STOP';stop.style.cssText='width:440px;height:30px;margin-top:6px';const ta=document.createElement('textarea');ta.placeholder='Paste the copied list here (Ctrl+V)';ta.style.cssText='width:440px;height:60px;margin-top:6px';const log=document.createElement('div');p.append(start,stop,ta,log);document.body.appendChild(p);const stats=S('uf_stats',{unfollowed:0,skipped:0,missing:0,failed:0});const show=m=>{const L=S('uf_list',[]);log.textContent='Progress: '+S('uf_idx',0)+'/'+L.length+'\nUnfollowed: '+stats.unfollowed+'  Skipped: '+stats.skipped+'  Gone: '+stats.missing+'  Failed: '+stats.failed+'\n'+(m||'')};if(S('uf_list',[]).length)ta.style.display='none';ta.oninput=()=>{try{const l=JSON.parse(ta.value);W('uf_list',l);W('uf_idx',0);ta.style.display='none';show('List saved ('+l.length+'). Press START.')}catch(e){}};let halt=false;stop.onclick=()=>{halt=true;show('Stopping after current...')};show('Ready.');start.onclick=async()=>{if(!S('uf_list',[]).length){show('Paste the list first.');return}halt=false;start.disabled=true;const w=window.open('/','uf_worker','width=1000,height=800');if(!w){show('Popup blocked - allow popups for instagram.com');start.disabled=false;return}const list=S('uf_list',[]);let fails=0;while(!halt){const i=S('uf_idx',0);if(i>=list.length){show('ALL DONE');break}const u=list[i];show('Checking @'+u);try{w.location.href='/'+encodeURIComponent(u)+'/'}catch(e){show('Popup closed - stopped.');break}await sleep(2500);let st=null;for(let k=0;k<30&&!st;k++){await sleep(500);let d;try{d=w.document}catch(e){continue}if(!d||!w.location.pathname.toLowerCase().startsWith('/'+u.toLowerCase()))continue;const t=d.body?.innerText||'';if(LIMIT.test(t))st='blocked';else if(/this page isn.t available/i.test(t))st='missing';else{const b=btns(d).map(x=>x.innerText.trim());if(b.includes('Following'))st='following';else if(b.some(x=>/^(Follow|Follow Back|Requested|Message)$/.test(x)))st='other'}}if(st==='blocked'){show('Instagram is limiting actions. Wait a few hours, then press START.');break}if(st!=='following'){if(st==='missing')stats.missing++;else if(st==='other')stats.skipped++;else stats.failed++;W('uf_idx',i+1);W('uf_stats',stats);await sleep(rnd(4000,8000));continue}const d=w.document;btns(d).find(x=>x.innerText.trim()==='Following').click();await sleep(rnd(1500,2500));const un=dlg(d,'Unfollow');if(!un){stats.failed++;fails++}else{un.click();await sleep(2000);const un2=dlg(d,'Unfollow');if(un2){un2.click();await sleep(2000)}if(LIMIT.test(d.body.innerText)){show('Limited at @'+u+'. Wait a few hours, then press START.');break}const now=btns(d).map(x=>x.innerText.trim());if(!now.includes('Following')&&now.some(x=>/^(Follow|Follow Back)$/.test(x))){stats.unfollowed++;fails=0}else{stats.failed++;fails++}}W('uf_idx',i+1);W('uf_stats',stats);if(fails>=3){show('3 failures in a row - stopped. Press START later.');break}show('Unfollowed @'+u+' - waiting...');await sleep(rnd(30000,50000))}start.disabled=false;if(halt)show('Stopped. Press START to resume.')}})();

javascript:(function(){function ffb(){var b=document.querySelectorAll('button[type="button"]');for(var i=0;i<b.length;i++){var t=b[i].querySelector('div[dir="auto"]');if(t&&t.textContent.trim()==='Following')return b[i];}return null;}function fuo(){var s=document.querySelectorAll('span');for(var i=0;i<s.length;i++){if(s[i].textContent.trim()==='Unfollow')return s[i].closest('div');}return null;}function wfe(fn,timeout,interval){return new Promise(function(res,rej){var start=Date.now();var timer=setInterval(function(){var el=fn();if(el){clearInterval(timer);res(el);}else if(Date.now()-start>timeout){clearInterval(timer);rej(new Error('Timed out waiting for element'));}},interval);});}function run(){var fb=ffb();if(!fb){alert('Could not find "Following" button.');return;}fb.click();wfe(fuo,5000,150).then(function(el){el.click();}).catch(function(e){alert(e.message);});}run();})();
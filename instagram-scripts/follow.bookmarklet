javascript:(function(){const b=Array.from(document.querySelectorAll('div._ap3a._aaco._aacw._aad6._aade[dir="auto"]')).filter(e=>e.textContent.trim()==='Follow');if(!b.length){alert('No buttons found.');return;}let i=0;function n(){if(i>=b.length){console.log('Done.');return;}const el=b[i];if(el.isConnected&&el.textContent.trim()==='Follow'){el.click();console.log('Clicked '+(i+1)+'/'+b.length);}i++;setTimeout(n,Math.floor(Math.random()*2500)+1500);}n();})();
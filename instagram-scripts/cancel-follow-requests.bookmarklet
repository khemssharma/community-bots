javascript:(()=>{const S=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},W=(k,v)=>localStorage.setItem(k,JSON.stringify(v)),sleep=ms=>new Promise(r=>setTimeout(r,ms)),rnd=(a,b)=>a+Math.random()*(b-a),btns=d=>[...d.querySelectorAll('button, div[role=button]')],LIMIT=/Try Again Later|restrict certain activity|action (was )?blocked/i;document.getElementById('cfr_panel')?.remove();const p=document.createElement('div');p.id='cfr_panel';p.style.cssText='position:fixed;top:10px;left:100px;z-index:99999;width:460px;background:lightyellow;color:black;font:14px monospace;padding:10px;border:2px solid black;white-space:pre-wrap';const start=document.createElement('button');start.textContent='START cancelling requests';start.style.cssText='width:440px;height:60px;font-size:18px;background:limegreen';const stop=document.createElement('button');stop.textContent='STOP';stop.style.cssText='width:440px;height:30px;margin-top:6px';const ta=document.createElement('textarea');ta.placeholder='Paste username list (JSON) here';ta.style.cssText='width:440px;height:60px;margin-top:6px';const log=document.createElement('div');p.append(start,stop,ta,log);document.body.appendChild(p);const stats=S('cfr_stats',{cancelled:0,skipped:0,missing:0,failed:0});const show=m=>{const L=S('cfr_list',[]);log.textContent='Progress: '+S('cfr_idx',0)+'/'+L.length+'\nCancelled: '+stats.cancelled+'  Not pending: '+stats.skipped+'  Gone: '+stats.missing+'  Failed: '+stats.failed+'\n'+(m||'')};if(S('cfr_list',[]).length)ta.style.display='none';ta.oninput=()=>{try{const l=JSON.parse(ta.value);W('cfr_list',l);W('cfr_idx',0);ta.style.display='none';show('List saved. Press START.')}catch(e){}};let halt=false;stop.onclick=()=>{halt=true;show('Stopping after current...')};show('Ready.');start.onclick=async()=>{halt=false;start.disabled=true;const w=window.open('/','cfr_worker','width=1000,height=800');if(!w){show('Popup blocked - allow popups for instagram.com');start.disabled=false;return}const list=S('cfr_list',[]);let fails=0;while(!halt){const i=S('cfr_idx',0);if(i>=list.length){show('ALL DONE');break}const u=list[i];show('Checking @'+u);try{w.location.href='/'+encodeURIComponent(u)+'/'}catch(e){show('Popup closed - stopped.');break}await sleep(2500);let st=null;for(let k=0;k<30&&!st;k++){await sleep(500);let d;try{d=w.document}catch(e){continue}if(!d||!w.location.pathname.toLowerCase().startsWith('/'+u.toLowerCase()))continue;const t=d.body?.innerText||'';if(LIMIT.test(t))st='blocked';else if(/this page isn.t available/i.test(t))st='missing';else{const b=btns(d).map(x=>x.innerText.trim());if(b.includes('Requested'))st='requested';else if(b.some(x=>/^(Follow|Following|Follow Back|Message)$/.test(x)))st='other'}}if(st==='blocked'){show('Instagram is limiting actions. Wait a few hours, then press START.');break}if(st!=='requested'){if(st==='missing')stats.missing++;else if(st==='other')stats.skipped++;else stats.failed++;W('cfr_idx',i+1);W('cfr_stats',stats);await sleep(rnd(4000,8000));continue}const d=w.document;btns(d).find(x=>x.innerText.trim()==='Requested').click();await sleep(rnd(1200,2000));const un=btns(d).find(x=>x.closest('[role=dialog]')&&x.innerText.trim()==='Unfollow');if(!un){stats.failed++;fails++}else{un.click();await sleep(3000);if(LIMIT.test(d.body.innerText)){show('Limited at @'+u+'. Wait a few hours, then press START.');break}const now=btns(d).map(x=>x.innerText.trim());if(now.includes('Follow')&&!now.includes('Requested')){stats.cancelled++;fails=0}else{stats.failed++;fails++}}W('cfr_idx',i+1);W('cfr_stats',stats);if(fails>=3){show('3 failures in a row - stopped. Press START later.');break}show('Cancelled @'+u+' - waiting...');await sleep(rnd(20000,35000))}start.disabled=false;if(halt)show('Stopped. Press START to resume.')}})();

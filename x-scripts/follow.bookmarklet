javascript:(function(){const b=Array.from(document.querySelectorAll('span.css-1jxf684.r-bcqeeo.r-1ttztb7.r-qvutc0.r-poiln3')).filter(e=>e.textContent.trim()==='Follow');if(!b.length){alert('No buttons found.');return;}let i=0;function n(){if(i>=b.length){console.log('Done.');return;}const el=b[i];if(el.isConnected&&el.textContent.trim()==='Follow'){el.click();console.log('Clicked '+(i+1)+'/'+b.length);}i++;setTimeout(n,Math.floor(Math.random()*500)+300);}n();})();